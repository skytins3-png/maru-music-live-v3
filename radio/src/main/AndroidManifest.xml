<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries>
        <package android:name="sg.bigo.live" />
    </queries>
    <application android:label="@string/app_name" android:icon="@drawable/ic_radio"
        android:theme="@android:style/Theme.Material.NoActionBar" android:appCategory="audio"
        android:allowBackup="false" android:supportsRtl="true">
        <receiver android:name=".RadioSchedule" android:exported="false" />
        <activity android:name=".RadioAutomationActivity" android:exported="false"
            android:launchMode="singleTop" />
        <activity android:name=".RadioActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
        <service android:name=".RadioPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- Must be turned on manually in Android Accessibility settings.
             Restricted to BIGO UI; never requested at install time. -->
        <service android:name=".BigoControlAssist"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/bigo_accessibility_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/bigo_control_config" />
        </service>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries>
        <package android:name="sg.bigo.live" />
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>
    <application android:label="@string/app_name" android:icon="@drawable/ic_radio"
        android:theme="@android:style/Theme.Material.NoActionBar" android:appCategory="audio"
        android:allowAudioPlaybackCapture="true" android:allowBackup="false" android:supportsRtl="true">
        <receiver android:name=".RadioSchedule" android:exported="false" />
        <activity android:name=".BigoAudioCheckActivity" android:exported="false" />
        <activity android:name=".RadioAutomationActivity" android:exported="false"
            android:launchMode="singleTop" />
        <activity android:name=".RadioActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
        <service android:name=".RadioPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>

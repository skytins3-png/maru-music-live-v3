# Required: randomly generated 32+ char secret, never commit real secrets
MARU_ADMIN_TOKEN=replace-with-a-unique-secret-of-at-least-32-characters
MARU_HASH_SALT=replace-with-another-random-32-character-secret-value
PORT=8080
# Use an external persistent volume; NEVER serve this directory directly.
MARU_STORAGE_DIR=/var/lib/maru-media-private
# Public app must be behind HTTPS reverse proxy.
# To enable automated safe publication install ClamAV clamscan executable.
# If clamscan is unavailable, attachments remain quarantine/manual review.
CLAMSCAN_CMD=clamscan
NODE_ENV=production
